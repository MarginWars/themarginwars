root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[site/src/**]
# Generated source of record: never reformat (byte-identical builds).
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = unset
indent_size = unset

[*.md]
# Markdown style is checked by markdownlint-cli2 (.markdownlint-cli2.jsonc); keep lines as the author wrapped them.
max_line_length = off

[*.{png,jpg,ico,woff2,ttf,pdf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
