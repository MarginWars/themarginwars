{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weekly content calendar (the approval unit)",
  "type": "object",
  "required": ["week", "status", "items"],
  "properties": {
    "week": {"type": "string", "pattern": "^\\d{4}-W\\d{2}$"},
    "status": {"enum": ["draft", "in-review", "approved"]},
    "standing_permission": {"type": ["string", "null"]},
    "items": {"type": "array", "items": {"type": "object", "required": ["file", "schedule"],
      "properties": {"file": {"type": "string"}, "schedule": {"type": "string"}, "channel": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
