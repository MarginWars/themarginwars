# bo-headers
# Non-production hosts are never indexed (production themarginwars.com has no X-Robots-Tag).
https://themarginwars.pages.dev/*
  X-Robots-Tag: noindex
https://themarginwars-dev.pages.dev/*
  X-Robots-Tag: noindex
https://:sub.themarginwars-dev.pages.dev/*
  X-Robots-Tag: noindex
/assets/b/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/api/*
  X-Robots-Tag: noindex
# /bo-headers
